# Pulse News Intelligence - Production Environment Configuration

# Core Application
PROJECT_NAME="Pulse Personal News Intelligence"
API_V1_STR="/api"
ENVIRONMENT="production"
DEBUG=False

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://pulse.news"]

# SQLite WAL & Connection Configuration
SQLITE_WAL_MODE=True
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_SYNCHRONOUS="NORMAL"
SQLITE_CACHE_SIZE=-64000

# Authentication & Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"
AUTH_SECRET_KEY="pulse-production-secure-random-secret-key-change-in-production"
AUTH_TOKEN_EXPIRE_DAYS=7

# Pipeline & Intelligence Tuning
BREAKING_NEWS_IMPORTANCE_THRESHOLD=85
DEFAULT_IMPORTANCE_FILTER=50
RELEVANCE_STUDENT_INTERESTS=["AI", "Software Engineering", "Cybersecurity", "Semiconductors", "Space", "Business", "Economy"]
