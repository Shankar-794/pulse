# Application Settings
PROJECT_NAME="Pulse Personal News Intelligence"
API_V1_STR="/api"
# Set to "production" in Render environment variables
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# CORS — Supply your production Vercel frontend URL in Render dashboard
# Example: BACKEND_CORS_ORIGINS=["https://pulse-drab-eight.vercel.app","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["https://pulse-drab-eight.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# Database Engine Selection:
# - If DATABASE_URL is set: PostgreSQL engine is used (required for Render production).
# - If DATABASE_URL is unset: SQLite engine is used for zero-friction local development.
# Render PostgreSQL Example:
# DATABASE_URL="postgresql://pulse_user:pulse_password@dpg-xxxxx-a.oregon-postgres.render.com/pulse_db"
DATABASE_URL=""

# SQLite Database Location (used when DATABASE_URL is unset)
SQLITE_DB_PATH="/app/data/pulse.db"
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT_MS=30000

# Intelligence Pipeline Thresholds
BREAKING_NEWS_IMPORTANCE_THRESHOLD=85
DEFAULT_IMPORTANCE_FILTER=50
RELEVANCE_STUDENT_INTERESTS=["AI", "Software Engineering", "Cybersecurity", "Semiconductors", "Space", "Business", "Economy"]

# Authentication & Google OAuth 2.0 (Supply in Render Environment Variables)
# In production, GOOGLE_CLIENT_SECRET and AUTH_SECRET_KEY must be kept private.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://pulse-drab-eight.vercel.app/auth/callback"
AUTH_SECRET_KEY="pulse-production-secure-random-secret-key"
AUTH_TOKEN_EXPIRE_DAYS=7
