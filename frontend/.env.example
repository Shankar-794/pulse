# Pulse Frontend Environment Configuration
# For production deployment on Vercel, set this to your Render backend URL:
# Example: VITE_API_BASE_URL=https://pulse-api.onrender.com
#
# In local development, leave this empty or unset to use Vite's local proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=
